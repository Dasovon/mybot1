<launch>
  <!-- Intel RealSense D435 — realsense2_camera v4.57.7 on ROS Jazzy
       Topics published:
         /camera/camera/color/image_raw           sensor_msgs/Image       15 Hz
         /camera/camera/color/camera_info         sensor_msgs/CameraInfo  15 Hz
         /camera/camera/depth/image_rect_raw      sensor_msgs/Image        6 Hz
         /camera/camera/depth/camera_info         sensor_msgs/CameraInfo   6 Hz
         /camera/camera/depth/color/points        sensor_msgs/PointCloud2  6 Hz (RGB8 colored)

       pointcloud__neon_.stream_filter=2 (COLOR) is set via config_file so the
       PointCloud2 messages contain an rgb field; this enables RGB8 in RViz2.
  -->
  <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
    <arg name="camera_name"    value="camera"/>
    <arg name="config_file"    value="$(find-pkg-share robot_bringup)/config/realsense.yaml"/>
    <arg name="publish_tf"     value="true"/>
  </include>
</launch>
