<launch>
  <!-- RPLidar A1 M8 — publishes /scan at ~5.5 Hz, frame_id=laser
       Device: /dev/rplidar (udev symlink, CP210x VID 10c4:ea60)
       Parameters: config/lidar.yaml -->

  <node pkg="rplidar_ros" exec="rplidar_composition" output="screen">
    <param from="$(find-pkg-share robot_bringup)/config/lidar.yaml"/>
  </node>
</launch>
