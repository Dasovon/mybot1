<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Sensor frame offsets from base_link origin (wheel axle height, robot center).
    These are PLACEHOLDER values — measure physical sensor positions and
    replace before Phase 3 EKF bringup. Incorrect transforms degrade EKF
    accuracy and distort Nav2 costmaps.
  -->

  <!-- RPLidar A1 M8 — top of chassis, centered -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.0 0.0 0.18" rpy="0 0 0"/>
  </joint>
  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Adafruit BNO055 — on ESP32 board, near chassis center -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <!-- Intel RealSense D435 — front face, forward-facing -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.09 0.0 0.10" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.025 0.090 0.025"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- RealSense depth origin — 15 mm left of color camera (D435 spec) -->
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0.0 0.015 0.0" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_frame"/>

</robot>
