<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Validated hardware values — do not change without updating CLAUDE.md -->
  <xacro:property name="wheel_radius" value="0.03414"/>
  <xacro:property name="wheel_width"  value="0.026"/>
  <xacro:property name="wheel_sep"    value="0.177"/>

  <!-- Measured chassis dimensions -->
  <xacro:property name="chassis_l" value="0.24"/>
  <xacro:property name="chassis_w" value="0.203"/>
  <xacro:property name="chassis_h" value="0.051"/>

  <!-- Wheelbase (front-to-rear axle distance) — PLACEHOLDER, measure when chassis arrives -->
  <xacro:property name="wheelbase"      value="0.18"/>

  <!-- Measured: motor shaft sits 23mm below chassis plate bottom surface.
       Ground clearance = wheel_radius - bracket_offset = 34.14 - 23 = 11.14mm -->
  <xacro:property name="bracket_offset" value="0.023"/>

  <!-- Inertia helpers -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(h*h+w*w)/12}" ixy="0" ixz="0"
        iyy="${m*(h*h+l*l)/12}" iyz="0"
        izz="${m*(l*l+w*w)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
        iyy="${m*(3*r*r+h*h)/12}" iyz="0"
        izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- Wheel macro — joint origin rpy="-pi/2 0 0" aligns cylinder z-axis with parent y-axis -->
  <xacro:macro name="wheel" params="name x_offset y_offset">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="0.15" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x_offset} ${y_offset} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <!-- base_footprint: ground-plane projection of base_link — required by Nav2 and robot_localization.
       No geometry; KDL complains if the root link has inertia, so this link carries none. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base chassis — origin at wheel axle height, centered between all four wheels.
       Chassis bottom face is bracket_offset above the axle, so box center is offset in z. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${bracket_offset + chassis_h/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${bracket_offset + chassis_h/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
    </collision>
    <xacro:box_inertia m="2.5" l="${chassis_l}" w="${chassis_w}" h="${chassis_h}"/>
  </link>

  <!-- Four wheels: front/rear × left/right -->
  <xacro:wheel name="front_left_wheel"  x_offset=" ${wheelbase/2}" y_offset=" ${wheel_sep/2}"/>
  <xacro:wheel name="front_right_wheel" x_offset=" ${wheelbase/2}" y_offset="-${wheel_sep/2}"/>
  <xacro:wheel name="rear_left_wheel"   x_offset="-${wheelbase/2}" y_offset=" ${wheel_sep/2}"/>
  <xacro:wheel name="rear_right_wheel"  x_offset="-${wheelbase/2}" y_offset="-${wheel_sep/2}"/>

</robot>
