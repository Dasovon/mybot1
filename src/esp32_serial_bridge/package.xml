<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>esp32_serial_bridge</name>
  <version>0.1.0</version>
  <description>Pi-side battery publisher: reads INA219 on Pi I2C-1, publishes /battery_state at 1 Hz, and enforces low-voltage cutoff via zero cmd_vel. twist_mux priority arbitration required before powered Nav2 motion testing.</description>
  <maintainer email="35791110+Dasovon@users.noreply.github.com">Dasovon</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
