[Unit]
Description=mybot1 battery publisher — INA219 on Pi I2C-1 → /battery_state
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/tmp
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && source /home/ubuntu/bot_ws/install/setup.bash && exec ros2 run esp32_serial_bridge battery_publisher"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
