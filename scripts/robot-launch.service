[Unit]
Description=MyBot ROS 2 Core Bringup — robot_state_publisher + EKF (no LiDAR)
After=network.target microros-agent.service
Wants=microros-agent.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/tmp
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/ubuntu/bot_ws/install/setup.bash && ros2 launch robot_bringup mybot-core.launch.xml'
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
